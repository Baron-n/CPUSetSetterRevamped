<Grid x:Class="CPUSetSetter.UI.Tabs.Processes.Benchmark.BenchmarkTab"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:CPUSetSetter.UI.Tabs.Processes.Benchmark"
      d:DataContext="{d:DesignInstance Type=local:BenchmarkViewModel}"
      mc:Ignorable="d">

    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*" MinHeight="120"/>
        <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid.Resources>
        <!--Score bar: a colored fill whose width reflects the result relative to the worst completed run-->
        <Style x:Key="ScoreBarStyle" TargetType="ProgressBar">
            <Setter Property="Maximum" Value="1"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="#1A000000"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="3">
                            <Grid x:Name="PART_Track">
                                <Border x:Name="PART_Indicator"
                                        HorizontalAlignment="Left"
                                        CornerRadius="2"
                                        Margin="1"
                                        Background="{TemplateBinding Foreground}"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Grid.Resources>

    <!--Target process-->
    <GroupBox Grid.Row="0" Header="Target process">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0"
                       Text="Search:"
                       Margin="5,0,0,0"
                       VerticalAlignment="Center"/>

            <TextBox Grid.Row="0" Grid.Column="1"
                     x:Name="targetSearchBox"
                     Margin="5,0,0,0"
                     MaxLines="1"
                     Text="{Binding TargetFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     TextChanged="TargetSearchBox_TextChanged"/>

            <Button Grid.Row="0" Grid.Column="2"
                    Margin="7,0,5,0"
                    Padding="8,2"
                    Content="Browse..."
                    Command="{Binding BrowseTargetCommand}"/>

            <ComboBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                      x:Name="targetComboBox"
                      Margin="5,5,5,0"
                      ItemsSource="{Binding TargetsView}"
                      SelectedItem="{Binding SelectedTarget, Mode=TwoWay}"
                      ToolTip="The process to benchmark. Its current mask is captured and restored afterwards">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayName}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                     Margin="5,5,5,5"
                     IsReadOnly="True"
                     Text="{Binding CustomTargetPath}"
                     ToolTip="The executable path picked with Browse... (only running processes can be benchmarked)"/>
        </Grid>
    </GroupBox>

    <!--Duration-->
    <Grid Grid.Row="1" Margin="5,8,5,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0" Text="Duration per mask:" VerticalAlignment="Center"/>
        <TextBox Grid.Column="1" Width="45" Margin="7,0,0,0" MaxLength="3"
                 VerticalContentAlignment="Center"
                 Text="{Binding DurationText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Grid.Column="2" Margin="7,0,0,0"
                   Text="seconds (3-120). Longer = more stable averages."
                   FontSize="11" Foreground="#808080" VerticalAlignment="Center"/>
    </Grid>

    <!--Candidate masks-->
    <GroupBox Grid.Row="2" Header="Masks to test">
        <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Candidates}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Margin="5,2"
                                  Content="{Binding DisplayName}"
                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </GroupBox>

    <!--Status / progress-->
    <Grid Grid.Row="3" Margin="5,8,5,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding StatusText}"
                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
        <TextBlock Grid.Row="0" HorizontalAlignment="Right"
                   Text="{Binding CountdownText}"
                   FontSize="12" VerticalAlignment="Center"/>

        <ProgressBar Grid.Row="1" Height="14" Margin="0,4,0,0"
                     Maximum="1"
                     Value="{Binding Progress}"/>
    </Grid>

    <!--Results table-->
    <GroupBox Grid.Row="4" Margin="5,8,5,5" Header="Results">
        <DataGrid ItemsSource="{Binding ResultsView}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  RowHeight="26"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#1F000000">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mask" Binding="{Binding MaskDisplayName}" Width="1.6*"/>

                <!--Score bar + value-->
                <DataGridTemplateColumn Header="Avg CPU" Width="1.1*" SortMemberPath="AverageCpuPercent">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3">
                                <ProgressBar Style="{StaticResource ScoreBarStyle}"
                                             Value="{Binding BarRatio}"
                                             Foreground="{Binding BarBrush}"/>
                                <TextBlock Text="{Binding AverageCpuPercentStr}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="11"
                                           FontWeight="SemiBold"/>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Busiest Cores" Binding="{Binding BusiestCores}" Width="1.8*"/>
                <DataGridTextColumn Header="Status" Binding="{Binding StatusStr}" Width="0.7*"/>
                <DataGridTextColumn Header="Duration" Binding="{Binding DurationSeconds}" Width="0.5*"/>
            </DataGrid.Columns>
        </DataGrid>
    </GroupBox>

    <!--Hint + buttons-->
    <Grid Grid.Row="5" Margin="5,0,5,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Vertical" Margin="0,0,10,0">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                <TextBlock Text="Score:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="#3CB040" VerticalAlignment="Center" Margin="0,0,2,0"/>
                <TextBlock Text="best (lowest CPU%)" FontSize="11" Foreground="#808080" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="#E53B3B" VerticalAlignment="Center" Margin="0,0,2,0"/>
                <TextBlock Text="worst (highest CPU%)" FontSize="11" Foreground="#808080" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="Note: a lower CPU% only means fewer cores were used. For games, judge real performance by FPS/frametimes in the game itself."
                       FontSize="11"
                       Foreground="#808080"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <Button Grid.Column="1" Padding="14,3" Margin="7,0,0,0"
                Content="Start"
                Command="{Binding StartCommand}"/>
        <Button Grid.Column="2" Padding="14,3" Margin="7,0,0,0"
                Content="Cancel"
                Command="{Binding CancelCommand}"/>
        <Button Grid.Column="3" Padding="14,3" Margin="7,0,0,0"
                Content="Export CSV..."
                Command="{Binding ExportCsvCommand}"/>
    </Grid>
</Grid>
