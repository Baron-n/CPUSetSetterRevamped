<Grid x:Class="CPUSetSetter.UI.Tabs.Processes.ProcessesTab"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:CPUSetSetter.UI.Tabs.Processes"
      xmlns:config="clr-namespace:CPUSetSetter.Config.Models"
      xmlns:ui="clr-namespace:CPUSetSetter.UI"
      xmlns:coreuse="clr-namespace:CPUSetSetter.UI.Tabs.Processes.CoreUsage"
      d:DataContext="{d:DesignInstance Type=local:ProcessesTabViewModel}"
      mc:Ignorable="d">

    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*" MinHeight="80"/>
        <RowDefinition Height="2"/>
        <RowDefinition Height="142" MinHeight="80" MaxHeight="350"/>
    </Grid.RowDefinitions>

    <Grid.Resources>
        <coreuse:UtilityToBrushConverter x:Key="UtilityToBrushConverter"/>
    </Grid.Resources>

    <!--Search Bar-->
    <Grid Grid.Row="0"
          Margin="3,5,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0"
                   Text="Search:"
                   VerticalAlignment="Center"/>

        <TextBox Grid.Column="1"
                 Margin="5,0,0,0"
                 MaxLines="1"
                 FontSize="14"
                 Text="{Binding ProcessNameFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

        <Button Grid.Column="2"
                Margin="5,0,0,0"
                Padding="8,2"
                VerticalAlignment="Center"
                Content="Benchmark..."
                Click="Benchmark_Click"/>
    </Grid>

    <!--Process list-->
    <DataGrid Grid.Row="1"
              Margin="0,10,0,8"
              ItemsSource="{Binding RunningProcesses}"
              AutoGenerateColumns="False"
              RowHeight="24"
              HeadersVisibility="Column"
              CanUserReorderColumns="False"
              CanUserDeleteRows="False"
              CanUserAddRows="False"
              CanUserResizeRows="False"
              ui:DataGridExtensions.SortDesc="True"
              SelectedItem="{Binding SelectedProcess, Mode=TwoWay}"
              PreviewMouseLeftButtonDown="ProcessesGrid_PreviewMouseLeftButtonDown"
              PreviewMouseLeftButtonUp="ProcessesGrid_PreviewMouseLeftButtonUp"
              RowDetailsVisibilityMode="VisibleWhenSelected">

        <DataGrid.RowDetailsTemplate>
            <DataTemplate>
                <Border Margin="8,2,8,4"
                        Padding="6,4"
                        BorderBrush="#808080"
                        BorderThickness="1"
                        CornerRadius="3"
                        SnapsToDevicePixels="True">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="CPU usage per core"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>

                            <TextBlock Grid.Column="1"
                                       Margin="10,0"
                                       Text="{Binding BusiestCoresStr}"
                                       FontSize="11"
                                       Foreground="#808080"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"/>

                            <Button Grid.Column="2"
                                    Content="Hide"
                                    Padding="6,1"
                                    FontSize="11"
                                    VerticalAlignment="Center"
                                    Click="HideDetails_Click"/>
                        </Grid>

                        <TextBlock Text="{Binding ActiveRestrictionInfo}"
                                   Margin="0,2,0,0"
                                   FontSize="10.5"
                                   Foreground="#80a5b0"
                                   TextTrimming="CharacterEllipsis"/>

                        <ItemsControl ItemsSource="{Binding PerCoreUsagesView}" Margin="0,4,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!--Fixed-size heat cell: wraps to new rows when the window is narrow, so nothing overlaps-->
                                    <Border Width="42"
                                            Height="24"
                                            Margin="1"
                                            CornerRadius="3"
                                            SnapsToDevicePixels="True"
                                            Background="{Binding Utility, Converter={StaticResource UtilityToBrushConverter}}"
                                            BorderBrush="#40000000"
                                            BorderThickness="0.5"
                                            ToolTip="{Binding TooltipStr}">
                                        <Grid>
                                            <TextBlock Text="{Binding UtilityStr}"
                                                       Foreground="White"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Effect>
                                                    <DropShadowEffect Color="Black" Opacity="0.5" BlurRadius="1.5" ShadowDepth="0.5"/>
                                                </TextBlock.Effect>
                                            </TextBlock>
                                            <Border VerticalAlignment="Bottom"
                                                    Height="9"
                                                    Background="#33000000"
                                                    CornerRadius="0,0,3,3">
                                                <TextBlock Text="{Binding Name}"
                                                           Foreground="White"
                                                           FontSize="6.5"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </DataTemplate>
        </DataGrid.RowDetailsTemplate>

        <DataGrid.CellStyle>
            <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding PreviousApplyFailed}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource ErrorBrush}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </DataGrid.CellStyle>

        <DataGrid.Columns>
            <!--Name column-->
            <DataGridTextColumn Header="Name"
                                Binding="{Binding Name}"
                                IsReadOnly="True"
                                Width="1*"/>

            <!--Path column-->
            <DataGridTextColumn Header="Path"
                                Binding="{Binding ImagePath}"
                                IsReadOnly="True"
                                Width="3*">
            </DataGridTextColumn>

            <!--Average CPU usage column-->
            <DataGridTextColumn Header="Avg CPU"
                                Binding="{Binding AverageCpuPercentageStr}"
                                SortMemberPath="AverageCpuUsage"
                                IsReadOnly="True"
                                CanUserResize="False"
                                Width="Auto"
                                ui:DataGridExtensions.SortDesc="True"/>

            <!--Core mask column-->
            <DataGridTemplateColumn Header="Core Mask"
                                    Width="120"
                                    SortMemberPath="Mask.DisplayName"
                                    ui:DataGridExtensions.SortDesc="True">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <ComboBox ItemsSource="{Binding LogicalProcessorMasks, Source={x:Static config:AppConfig.Instance}}"
                                  SelectedValue="{Binding Mask, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
        </DataGrid.Columns>
    </DataGrid>

    <GridSplitter Grid.Row="2"
                  HorizontalAlignment="Stretch"
                  ResizeDirection="Rows"/>

    <!--Core Usage and Log-->
    <Grid Grid.Row="3">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Core Usage -->
        <GroupBox Grid.Column="0" Header="Core Usage">
            <coreuse:CoreUsageControl/>
        </GroupBox>

        <!--Log-->
        <GroupBox Grid.Column="1"
                  Margin="2,0,0,0"
                  Header="Log">
            <TextBox x:Name="logBox"
                     IsReadOnly="True"
                     Text="{Binding Text, Source={x:Static local:WindowLogger.Default}}"
                     TextChanged="Log_TextChanged"
                     TextWrapping="Wrap"/>
        </GroupBox>
    </Grid>
</Grid>
