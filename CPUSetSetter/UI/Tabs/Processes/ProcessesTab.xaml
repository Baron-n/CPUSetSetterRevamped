<Grid x:Class="CPUSetSetter.UI.Tabs.Processes.ProcessesTab"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:CPUSetSetter.UI.Tabs.Processes"
      xmlns:config="clr-namespace:CPUSetSetter.Config.Models"
      xmlns:ui="clr-namespace:CPUSetSetter.UI"
      xmlns:uiConv="clr-namespace:CPUSetSetter.UI.Converters"
      xmlns:coreuse="clr-namespace:CPUSetSetter.UI.Tabs.Processes.CoreUsage"
      d:DataContext="{d:DesignInstance Type=local:ProcessesTabViewModel}"
      mc:Ignorable="d">

    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*" MinHeight="80"/>
        <RowDefinition Height="2"/>
        <RowDefinition Height="300" MinHeight="200" MaxHeight="600"/>
    </Grid.RowDefinitions>

    <Grid.Resources>
        <coreuse:UtilityToBrushConverter x:Key="UtilityToBrushConverter"/>
        <uiConv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <uiConv:PercentToWidthConverter x:Key="PercentToWidthConverter"/>

        <!--Restriction chip styles-->
        <Style x:Key="ChipStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="7,1.5"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>
    </Grid.Resources>

    <!--Toolbar-->
    <Border Grid.Row="0" Padding="6,8,6,4">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!--Search-->
            <Grid Grid.Column="0" Margin="0,0,8,0">
                <TextBox x:Name="searchBox"
                         Height="28"
                         MaxLines="1"
                         FontSize="13"
                         Padding="24,0,6,0"
                         Text="{Binding ProcessNameFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         TextChanged="SearchBox_TextChanged"/>
                <StackPanel Orientation="Horizontal"
                            IsHitTestVisible="False"
                            VerticalAlignment="Center"
                            Margin="8,0,0,0">
                    <Path Data="M 0 0 L 8 8 M 0 0 A 4 4 0 1 1 8 0 A 4 4 0 1 1 0 0 M 5 5 L 8 8"
                          Stroke="{DynamicResource DisabledForegroundBrush}"
                          StrokeThickness="1.4"
                          Width="14"
                          Height="14"
                          Stretch="Uniform"/>
                    <TextBlock x:Name="searchWatermark"
                               Text="Search processes (Ctrl+K)"
                               Foreground="{DynamicResource DisabledForegroundBrush}"
                               FontSize="13"
                               Margin="6,0,0,0"/>
                </StackPanel>
            </Grid>

            <!--Refresh-->
            <Button Grid.Column="1"
                    Height="28"
                    Padding="10,0"
                    Margin="0,0,6,0"
                    ToolTip="Rescan running processes"
                    Click="Refresh_Click">
                <StackPanel Orientation="Horizontal">
                    <Path Data="M 2 8 A 6 6 0 1 1 8 2 M 8 0 V 3 H 5"
                          Stroke="{DynamicResource ForegroundBrush}"
                          StrokeThickness="1.5"
                          Width="14"
                          Height="14"
                          Stretch="Uniform"/>
                    <TextBlock Text="Refresh" Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!--Pause / Resume-->
            <Button x:Name="pauseButton"
                    Grid.Column="2"
                    Height="28"
                    Padding="10,0"
                    Margin="0,0,6,0"
                    ToolTip="Pause/resume the live-sorted list"
                    Click="Pause_Click">
                <StackPanel Orientation="Horizontal">
                    <Path x:Name="pauseIcon"
                          Data="M 2 2 H 5 V 11 H 2 Z M 8 2 H 11 V 11 H 8 Z"
                          Fill="{DynamicResource ForegroundBrush}"
                          Width="14"
                          Height="14"
                          Stretch="Uniform"/>
                    <TextBlock x:Name="pauseLabel" Text="Pause" Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!--Benchmark-->
            <Button Grid.Column="3"
                    Height="28"
                    Padding="10,0"
                    Style="{StaticResource PrimaryButton}"
                    Click="Benchmark_Click"
                    ToolTip="Open the Benchmark tab">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Benchmark" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>
    </Border>

    <!--Process list-->
    <DataGrid Grid.Row="1"
              Margin="0,0,0,8"
              ItemsSource="{Binding RunningProcesses}"
              AutoGenerateColumns="False"
              RowHeight="34"
              HeadersVisibility="Column"
              CanUserReorderColumns="False"
              CanUserDeleteRows="False"
              CanUserAddRows="False"
              CanUserResizeRows="False"
              ui:DataGridExtensions.SortDesc="True"
              SelectedItem="{Binding SelectedProcess, Mode=TwoWay}"
              PreviewMouseLeftButtonDown="ProcessesGrid_PreviewMouseLeftButtonDown"
              PreviewMouseLeftButtonUp="ProcessesGrid_PreviewMouseLeftButtonUp"
              RowDetailsVisibilityMode="VisibleWhenSelected">

        <DataGrid.RowDetailsTemplate>
            <DataTemplate>
                <Border Margin="8,2,8,4"
                        Padding="6,4"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        SnapsToDevicePixels="True">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="CPU usage per core"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>

                            <TextBlock Grid.Column="1"
                                       Margin="10,0"
                                       Text="{Binding BusiestCoresStr}"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"/>

                            <Button Grid.Column="2"
                                    Content="Hide"
                                    Padding="6,1"
                                    FontSize="11"
                                    VerticalAlignment="Center"
                                    Click="HideDetails_Click"/>
                        </Grid>

                        <TextBlock Text="{Binding ActiveRestrictionInfo}"
                                   Margin="0,2,0,0"
                                   FontSize="11"
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   FontWeight="Medium"
                                   TextTrimming="CharacterEllipsis"/>

                        <ItemsControl ItemsSource="{Binding PerCoreUsagesView}" Margin="0,4,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!--Fixed-size heat cell: wraps to new rows when the window is narrow, so nothing overlaps.
                                        The % sits on a dark badge so it stays readable over the bright heat colors-->
                                    <Border Width="44"
                                            Height="26"
                                            Margin="1"
                                            CornerRadius="3"
                                            SnapsToDevicePixels="True"
                                            Background="{Binding Utility, Converter={StaticResource UtilityToBrushConverter}}"
                                            BorderBrush="#40000000"
                                            BorderThickness="0.5"
                                            ToolTip="{Binding TooltipStr}">
                                        <Grid>
                                            <Border HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Background="#66000000"
                                                    CornerRadius="3"
                                                    Padding="4,1">
                                                <TextBlock Text="{Binding UtilityStr}"
                                                           Foreground="White"
                                                           FontSize="10.5"
                                                           FontWeight="Bold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center">
                                                    <TextBlock.Effect>
                                                        <DropShadowEffect Color="Black" Opacity="0.6" BlurRadius="1" ShadowDepth="0.3"/>
                                                    </TextBlock.Effect>
                                                </TextBlock>
                                            </Border>
                                            <Border VerticalAlignment="Bottom"
                                                    Height="9"
                                                    Background="#66000000"
                                                    CornerRadius="0,0,3,3">
                                                <TextBlock Text="{Binding Name}"
                                                           Foreground="White"
                                                           FontSize="7"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </DataTemplate>
        </DataGrid.RowDetailsTemplate>

        <DataGrid.CellStyle>
            <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding PreviousApplyFailed}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource ErrorBrush}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </DataGrid.CellStyle>

        <DataGrid.Columns>
            <!--Name column-->
            <DataGridTextColumn Header="Name"
                                Binding="{Binding Name}"
                                IsReadOnly="True"
                                Width="1*"/>

            <!--Path column-->
            <DataGridTextColumn Header="Path"
                                Binding="{Binding ImagePath}"
                                IsReadOnly="True"
                                Width="3*">
            </DataGridTextColumn>

            <!--Restriction chips column-->
            <DataGridTemplateColumn Header="Restriction"
                                    Width="158"
                                    SortMemberPath="HasCpuSetRestriction"
                                    ui:DataGridExtensions.SortDesc="True">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource ChipStyle}"
                                    Background="#3B82F6"
                                    Visibility="{Binding HasCpuSetRestriction, Converter={StaticResource BoolToVisibilityConverter}}"
                                    ToolTip="This process is restricted to a CPU Set">
                                <TextBlock Text="CPU Set"
                                           Foreground="White"
                                           FontSize="10.5"
                                           FontWeight="SemiBold"/>
                            </Border>
                            <Border Style="{StaticResource ChipStyle}"
                                    Background="#F59E0B"
                                    Visibility="{Binding HasAffinityRestriction, Converter={StaticResource BoolToVisibilityConverter}}"
                                    ToolTip="This process has a narrowed Affinity mask">
                                <TextBlock Text="Affinity"
                                           Foreground="White"
                                           FontSize="10.5"
                                           FontWeight="SemiBold"/>
                            </Border>
                            <Border Style="{StaticResource ChipStyle}"
                                    Background="#22C55E"
                                    Visibility="{Binding HasRuleMatch, Converter={StaticResource BoolToVisibilityConverter}}"
                                    ToolTip="A rule matches this process and applies a mask automatically">
                                <TextBlock Text="Rule Match"
                                           Foreground="White"
                                           FontSize="10.5"
                                           FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <!--Average CPU usage column with bar-->
            <DataGridTemplateColumn Header="Avg CPU"
                                    Width="120"
                                    SortMemberPath="AverageCpuUsage"
                                    CanUserResize="False"
                                    ui:DataGridExtensions.SortDesc="True">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="86"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Height="6"
                                    CornerRadius="3"
                                    Background="{DynamicResource HoverBackgroundBrush}"
                                    VerticalAlignment="Center">
                                <Border CornerRadius="3"
                                        HorizontalAlignment="Left"
                                        Background="{DynamicResource AccentBrush}"
                                        Width="{Binding AverageCpuUsage, Converter={StaticResource PercentToWidthConverter}, ConverterParameter=86}"/>
                            </Border>
                            <TextBlock Grid.Column="1"
                                       Margin="8,0,0,0"
                                       Text="{Binding AverageCpuPercentageStr}"
                                       FontSize="12"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <!--Current CPU usage column with bar-->
            <DataGridTemplateColumn Header="Current"
                                    Width="110"
                                    SortMemberPath="CurrentCpuUsage"
                                    CanUserResize="False"
                                    ui:DataGridExtensions.SortDesc="True">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="76"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Height="6"
                                    CornerRadius="3"
                                    Background="{DynamicResource HoverBackgroundBrush}"
                                    VerticalAlignment="Center">
                                <Border CornerRadius="3"
                                        HorizontalAlignment="Left"
                                        Background="#22C55E"
                                        Width="{Binding CurrentCpuUsage, Converter={StaticResource PercentToWidthConverter}, ConverterParameter=76}"/>
                            </Border>
                            <TextBlock Grid.Column="1"
                                       Margin="8,0,0,0"
                                       Text="{Binding CurrentCpuPercentageStr}"
                                       FontSize="12"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <!--Core mask column-->
            <DataGridTemplateColumn Header="Core Mask"
                                    Width="120"
                                    SortMemberPath="Mask.DisplayName"
                                    ui:DataGridExtensions.SortDesc="True">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <ComboBox ItemsSource="{Binding LogicalProcessorMasks, Source={x:Static config:AppConfig.Instance}}"
                                  SelectedValue="{Binding Mask, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
        </DataGrid.Columns>
    </DataGrid>

    <GridSplitter Grid.Row="2"
                  HorizontalAlignment="Stretch"
                  ResizeDirection="Rows"/>

    <!--Core Usage and Log-->
    <Grid Grid.Row="3">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="100"/>
            <RowDefinition Height="2"/>
            <RowDefinition Height="*" MinHeight="80"/>
        </Grid.RowDefinitions>

        <!-- Core Usage -->
        <coreuse:CoreUsageControl Grid.Row="0" Margin="0,0,0,2"/>

        <GridSplitter Grid.Row="1"
                      HorizontalAlignment="Stretch"
                      ResizeDirection="Rows"
                      Background="{DynamicResource BorderBrush}"/>

        <!--Log-->
        <GroupBox Grid.Row="2" Header="Log" Margin="0,2,0,0">
            <RichTextBox x:Name="logBox"
                         IsReadOnly="True"
                         BorderThickness="0"
                         Background="Transparent"
                         Foreground="{DynamicResource ForegroundBrush}"
                         FontSize="11"
                         TextChanged="Log_TextChanged"/>
        </GroupBox>
    </Grid>
</Grid>
