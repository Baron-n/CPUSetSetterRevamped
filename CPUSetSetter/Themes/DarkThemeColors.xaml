<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Accent -->
    <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#2F6FE4"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#2563EB"/>
    <SolidColorBrush x:Key="AccentLightBrush" Color="#223250"/>
    <SolidColorBrush x:Key="AccentBorderBrush" Color="#3B82F6"/>

    <!-- Surfaces -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#16181D"/>
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#1E2127"/>
    <SolidColorBrush x:Key="DisabledBackgroundBrush" Color="#23262D"/>
    <SolidColorBrush x:Key="ClickableBackgroundBrush" Color="#1E2127"/>
    <SolidColorBrush x:Key="HoverBackgroundBrush" Color="#262B33"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#262B33"/>
    <SolidColorBrush x:Key="SelectedBackgroundBrush" Color="#223250"/>

    <!-- Title bar -->
    <SolidColorBrush x:Key="TitleBarBrush" Color="#121418"/>
    <SolidColorBrush x:Key="TitleBarForegroundBrush" Color="#E6E9EF"/>
    <SolidColorBrush x:Key="TitleBarHoverBrush" Color="#262B33"/>
    <SolidColorBrush x:Key="TitleBarCloseHoverBrush" Color="#E81123"/>

    <!-- Text -->
    <SolidColorBrush x:Key="ForegroundBrush" Color="#E6E9EF"/>
    <SolidColorBrush x:Key="DisabledForegroundBrush" Color="#5C6270"/>

    <!-- Borders -->
    <SolidColorBrush x:Key="BorderBrush" Color="#2C3038"/>
    <SolidColorBrush x:Key="DisabledBorderBrush" Color="#3A3F48"/>
    <SolidColorBrush x:Key="ClickableBorderBrush" Color="#3A3F48"/>
    <SolidColorBrush x:Key="HoverBorderBrush" Color="#3B82F6"/>

    <SolidColorBrush x:Key="ComboBoxItemBackgroundBrush" Color="#262B33"/>
    <SolidColorBrush x:Key="DataGridHeaderBorderBrush" Color="#2C3038"/>
    <SolidColorBrush x:Key="ScrollBarBackgroundBrush" Color="#3A3F48"/>

    <SolidColorBrush x:Key="ErrorBrush" Color="#E5534B"/>

    <Thickness x:Key="GroupBoxBorderThickness">1</Thickness>

    <SolidColorBrush x:Key="CoreUsageBarBackgroundBrush" Color="#262B33"/>
    <SolidColorBrush x:Key="CoreUsageBarParkedBackgroundBrush" Color="#4A505C"/>
    <SolidColorBrush x:Key="CoreUsageBarForegroundBrush" Color="#22D3EE"/>
    <SolidColorBrush x:Key="CoreUsageBarParkedForegroundBrush" Color="#6A7080"/>
    <SolidColorBrush x:Key="CoreUsageBarBorderBrush" Color="#3A3F48"/>

    <!-- Status pill -->
    <SolidColorBrush x:Key="StatusPillBackgroundBrush" Color="#1A3323"/>
    <SolidColorBrush x:Key="StatusPillBorderBrush" Color="#2E7D4F"/>
    <SolidColorBrush x:Key="StatusDotBrush" Color="#34D399"/>

    <!-- Log colors -->
    <SolidColorBrush x:Key="LogInfoBrush" Color="#9AA1AC"/>
    <SolidColorBrush x:Key="LogSuccessBrush" Color="#34D399"/>
    <SolidColorBrush x:Key="LogWarningBrush" Color="#FBBF24"/>
    <SolidColorBrush x:Key="LogErrorBrush" Color="#F87171"/>

</ResourceDictionary>
