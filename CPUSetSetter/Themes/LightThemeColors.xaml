<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Accent -->
    <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#2563EB"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="AccentLightBrush" Color="#DBEAFE"/>
    <SolidColorBrush x:Key="AccentBorderBrush" Color="#93C5FD"/>

    <!-- Surfaces -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#F7F8FA"/>
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="White"/>
    <SolidColorBrush x:Key="DisabledBackgroundBrush" Color="#F1F3F6"/>
    <SolidColorBrush x:Key="ClickableBackgroundBrush" Color="White"/>
    <SolidColorBrush x:Key="HoverBackgroundBrush" Color="#EEF2F7"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#EEF2F7"/>
    <SolidColorBrush x:Key="SelectedBackgroundBrush" Color="#E3EDFC"/>

    <!-- Title bar -->
    <SolidColorBrush x:Key="TitleBarBrush" Color="#F1F3F6"/>
    <SolidColorBrush x:Key="TitleBarForegroundBrush" Color="#1F2430"/>
    <SolidColorBrush x:Key="TitleBarHoverBrush" Color="#E4E9F0"/>
    <SolidColorBrush x:Key="TitleBarCloseHoverBrush" Color="#E81123"/>

    <!-- Text -->
    <SolidColorBrush x:Key="ForegroundBrush" Color="#1F2430"/>
    <SolidColorBrush x:Key="DisabledForegroundBrush" Color="#9AA1AC"/>

    <!-- Borders -->
    <SolidColorBrush x:Key="BorderBrush" Color="#E4E7EC"/>
    <SolidColorBrush x:Key="DisabledBorderBrush" Color="#D1D5DB"/>
    <SolidColorBrush x:Key="ClickableBorderBrush" Color="#D1D5DB"/>
    <SolidColorBrush x:Key="HoverBorderBrush" Color="#93C5FD"/>

    <SolidColorBrush x:Key="ComboBoxItemBackgroundBrush" Color="White"/>
    <SolidColorBrush x:Key="DataGridHeaderBorderBrush" Color="#E4E7EC"/>
    <SolidColorBrush x:Key="ScrollBarBackgroundBrush" Color="#C6CBD4"/>

    <SolidColorBrush x:Key="ErrorBrush" Color="#EF4444"/>

    <Thickness x:Key="GroupBoxBorderThickness">1</Thickness>

    <SolidColorBrush x:Key="CoreUsageBarBackgroundBrush" Color="#E8EBF0"/>
    <SolidColorBrush x:Key="CoreUsageBarParkedBackgroundBrush" Color="#9AA1AC"/>
    <SolidColorBrush x:Key="CoreUsageBarForegroundBrush" Color="#22D3EE"/>
    <SolidColorBrush x:Key="CoreUsageBarParkedForegroundBrush" Color="#6B7280"/>
    <SolidColorBrush x:Key="CoreUsageBarBorderBrush" Color="#D1D5DB"/>

    <!-- Status pill -->
    <SolidColorBrush x:Key="StatusPillBackgroundBrush" Color="#E7F6EC"/>
    <SolidColorBrush x:Key="StatusPillBorderBrush" Color="#9FDFB8"/>
    <SolidColorBrush x:Key="StatusDotBrush" Color="#22C55E"/>

    <!-- Log colors -->
    <SolidColorBrush x:Key="LogInfoBrush" Color="#6B7280"/>
    <SolidColorBrush x:Key="LogSuccessBrush" Color="#16A34A"/>
    <SolidColorBrush x:Key="LogWarningBrush" Color="#D97706"/>
    <SolidColorBrush x:Key="LogErrorBrush" Color="#DC2626"/>

</ResourceDictionary>
